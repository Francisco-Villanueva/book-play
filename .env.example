DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
APP_PORT=3000
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d
MP_ACCESS_TOKEN=[mercado-pago-access-token]
MP_WEBHOOK_SECRET=[mercado-pago-webhook-secret]
MP_BACK_URL=http://localhost:5173
MP_WEBHOOK_URL=[public-url]/api/webhooks/mercadopago

# ---- Correo (SMTP / Nodemailer) ----
MAIL_ENABLED=false
MAIL_HOST=[smtp-host]
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=[smtp-user]
MAIL_PASSWORD=[smtp-password]
MAIL_FROM=Book & Play <no-reply@tudominio.com>
MAIL_REPLY_TO=
FRONTEND_URL=http://localhost:5173
MAIL_LOGO_URL=

# ---- App ----
# Zona en la que se resuelven "hoy" y "ahora" de todo el dominio. NO depende de
# la TZ del contenedor (Render corre en UTC).
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Orígenes permitidos por CORS, separados por coma. Vacío = los propios por
# defecto (platform.book-and-play.com.ar, el .vercel.app y localhost).
CORS_ORIGINS=

# Publica /docs. Ausente o distinto de "true" = apagado. Dejar SIN setear en
# producción: expone toda la superficie de la API.
SWAGGER_ENABLED=true
