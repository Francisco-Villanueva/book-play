DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
APP_PORT=3000
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d
MP_ACCESS_TOKEN=[mercado-pago-access-token]
MP_WEBHOOK_SECRET=[mercado-pago-webhook-secret]
MP_BACK_URL=http://localhost:5173
MP_WEBHOOK_URL=[public-url]/api/webhooks/mercadopago

# ---- Correo (SMTP / Nodemailer) ----
MAIL_ENABLED=false
MAIL_HOST=[smtp-host]
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=[smtp-user]
MAIL_PASSWORD=[smtp-password]
MAIL_FROM=Book & Play <no-reply@tudominio.com>
MAIL_REPLY_TO=
FRONTEND_URL=https://platform.book-and-play.com.ar
MAIL_LOGO_URL=

# ---- App ----
# Zona en la que se resuelven "hoy" y "ahora" de todo el dominio. NO depende de
# la TZ del contenedor (Render corre en UTC).
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Orígenes permitidos por CORS, separados por coma. Vacío = los propios por
# defecto (platform.book-and-play.com.ar, el .vercel.app y localhost).
CORS_ORIGINS=

# Publica /docs. Ausente o distinto de "true" = apagado. Dejar SIN setear en
# producción: expone toda la superficie de la API.
SWAGGER_ENABLED=true

# ---- Geocoding (Nominatim / OpenStreetMap) ----
# Convierte la direccion del complejo en coordenadas para el orden por cercania
# de la home publica. Gratis y sin API key, a cambio de un limite de 1 req/s.
# Sin coordenadas el complejo igual aparece en su ciudad.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Su politica de uso EXIGE identificar la aplicacion y un contacto.
NOMINATIM_USER_AGENT=BookAndPlay/1.0 (+https://bookandplay.app)
# false (dev/test) = se loguea y no se sale a la red.
NOMINATIM_ENABLED=true
NOMINATIM_TIMEOUT_MS=5000
